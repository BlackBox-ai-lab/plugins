def render_ladder(rows, days):
    """A vertical recency ladder. Today in full cards, this week in medium
    cards, this month as compact rows, older weeks collapsed to single
    groups — screen density falls off with age, no sideways scrolling."""
    e = html.escape
    counts, ranked, color = _project_colors(rows)
    keys, buckets = _day_buckets(rows, days)
    ov = _overview(keys, buckets)
    lg = _legend(counts, ranked, color)
    live = live_status()
    ops = bool(CFG.get("refresh_url"))  # ▶ open needs the desktop endpoint
    nk = len(keys)

    def wdlbl(k):
        return "%s %s" % (time.strftime("%a", time.strptime(k, "%Y-%m-%d")), k[5:])

    today_html, week, month = "", [], []
    for j in range(nk - 1, -1, -1):
        k, age, rs = keys[j], nk - 1 - j, buckets[keys[j]]
        if age > 30 or not rs:
            continue
        rs = list(reversed(rs))  # newest first within a group
        if age == 0:
            # today fans out into one column per repo, most recently
            # active repo first, that repo's sessions stacked beneath it
            groups = {}
            for x in rs:
                groups.setdefault(x["repo"], []).append(x)
            order = sorted(groups, key=lambda g: -groups[g][0]["mtime"])
            rcols = []
            for g in order:
                gs = groups[g]
                pills = "".join(_pill(x, color, "%H:%M", live, ops) for x in gs)
                rcols.append('<div class="rcol"><div class="rh"><i style="background:%s">'
                             '</i>%s<span>%d</span></div>%s</div>'
                             % (color.get(g, TL_OTHER), e(g), len(gs), pills))
            today_html = ('<div class="day t0" data-d="%s" data-n="999">'
                          '<div class="dh">%s<span>%d</span></div>'
                          '<div class="gr cols">%s</div></div>'
                          % (k, wdlbl(k), len(rs), "".join(rcols)))
        elif age <= 7:
            week.append(_col(color, " t1", k, "", wdlbl(k), rs, 10, "%H:%M", live, ops))
        else:
            month.append(_col(color, " t2 slim", k, "", wdlbl(k), rs, 5, "%H:%M", live, ops))

    older, j = [], 0
    while j < nk and (nk - 1 - j) > 30:
        wk_keys = []
        while j < nk and (nk - 1 - j) > 30 and len(wk_keys) < 7:
            wk_keys.append(keys[j])
            j += 1
        rs = [r for kk in wk_keys for r in buckets[kk]]
        if rs:
            older.append(_col(color, " t3 slim", wk_keys[0], ' data-e="%s"' % wk_keys[-1],
                              "wk of %s" % wk_keys[0][5:], list(reversed(rs)), 5,
                              "%m-%d %H:%M", live, ops))
    older.reverse()

    secs = []
    if today_html:
        secs.append('<section><h2>Today<span class="n">%d sessions</span></h2>%s</section>'
                    % (len(buckets[keys[-1]]), today_html))
    for title, chunk in (("This week", week), ("This month", month), ("Older", older)):
        if chunk:
            secs.append('<section><h2>%s</h2>%s</section>' % (title, "".join(chunk)))

    rf_btn = ('<button id="rf" data-u="%s" title="regenerate now from the desktop">'
              '↻ refresh</button>' % CFG["refresh_url"] if CFG.get("refresh_url") else "")
    stamp = time.strftime("%Y-%m-%d %H:%M %Z")
    return ("""<!doctype html><html lang="en"><head><meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Claude session ladder</title>""" + TL_CSS + LD_EXTRA + """</head><body>
<header><div class="wrap"><h1>Claude session ladder</h1>
<div class="sub">%d sessions · last %d days · newest first, density falls with age:
Today in full cards, this week medium, this month compact, older weeks collapsed.
Click a card to expand its gist and resume command. Search covers titles, first prompts,
gists — and for recent sessions, words from the transcript tail. The strip jumps to any day.
List view: <a href="%s">session atlas</a>.
Updated %s.</div></div></header>
<div class="wrap">
<div class="ctl"><input id="q" type="search" placeholder="search %d sessions…">
<span id="cnt">%d of %d</span>
%s%s</div>
<div class="ov">%s</div>
%s
</div>""" % (len(rows), days, CFG["atlas_url"], stamp, len(rows), len(rows),
             len(rows), rf_btn, lg, ov, "".join(secs))
            + LD_JS + "</body></html>")


def _searchable(rows):
    """Attach cached gist/deep words so --find and --resolve share the
    ladder's recall without re-reading any transcript."""
    cache = _load_cache()
    for r in rows:
        c = cache.get(r["sid"])
        if c:
            r["gist"] = r.get("gist") or c.get("gist") or ""
            r["deep"] = c.get("deep") or ""
            if not r["name"] and c.get("name"):
                r["name"] = c["name"]
    return rows


def _score(rows, query):
    """All-terms-match dominates; then weighted hit count; then recency.
    The session running this search (CLAUDE_CODE_SESSION_ID) is excluded."""
    terms = [w for w in query.lower().split() if w]
    me = os.environ.get("CLAUDE_CODE_SESSION_ID", "")
    scored = []
    for r in rows:
        if r["sid"] == me:
            continue
        head = " ".join([r["repo"], r["name"] or "", r["first"], r["summary"],
                         r.get("gist") or ""]).lower()
        deep = r.get("deep") or ""
        matched = sum(1 for w in terms if w in head or w in deep)
        if not matched:
            continue
        # head hits weigh more than deep-index hits
        weight = sum(3 * head.count(w) + deep.count(w) for w in terms)
        scored.append(((matched == len(terms)), matched, weight, r))
    scored.sort(key=lambda s: (-s[0], -s[1], -s[2], -s[3]["mtime"]))
    return [r for _, _, _, r in scored]


def find(rows, query, limit=8):
    """Token-cheap lookup for in-session use: compact matches, resume-ready.
    A skill should call THIS, never read the atlas HTML into context."""
    hits = _score(_searchable(rows), query)
    if not hits:
        print(f"no sessions match: {query}")
        return
    live = live_status()
    for r in hits[:limit]:
        when = time.strftime("%m-%d %H:%M", time.localtime(r["mtime"]))
        topic = (r["name"] or r["summary"] or r["first"])[:110]
        badge = "  ● running" if r["sid"] in live else ""
        print(f"{when}  [{r['repo']}] ({r['acct']}){badge}  {topic}")
        print(f"        cd {r['cwd']} && {r['launcher']} --resume {r['sid']}")


def resolve(rows, query, limit=5):
    """Machine-readable resolution for agents and sibling tools. Accepts a
    sid prefix (>=6 hex chars) or free-text search. TSV:
    sid <TAB> acct <TAB> launcher <TAB> cwd <TAB> running|- <TAB> iso-mtime <TAB> topic"""
    rows = _searchable(rows)
    if re.fullmatch(r"[0-9a-fA-F-]{6,36}", query):
        hits = [r for r in rows if r["sid"].startswith(query.lower())]
    else:
        hits = _score(rows, query)
    live = live_status()
    for r in hits[:limit]:
        topic = re.sub(r"\s+", " ", (r["name"] or r["summary"] or r["first"]))[:80]
        print("\t".join([
            r["sid"], r["acct"], r["launcher"], r["cwd"],
            "running" if r["sid"] in live else "-",
            time.strftime("%Y-%m-%dT%H:%M:%S", time.localtime(r["mtime"])), topic]))
    if not hits:
        print(f"no sessions match: {query}", file=sys.stderr)
        return 1
    return 0


def import_session(rows, sid_prefix, to_label=None, force=False):
    """Copy a session's transcript into another account's projects tree so
    the session can be resumed (as an independent copy) under that account's
    launcher. Refuses live sessions unless --force."""
    hits = [r for r in rows if r["sid"].startswith(sid_prefix.lower())]
    if not hits:
        print(f"no session matches sid prefix: {sid_prefix}", file=sys.stderr)
        return 1
    if len({r["sid"] for r in hits}) > 1:
        print(f"ambiguous prefix ({len(hits)} matches) — give more characters",
              file=sys.stderr)
        return 1
    # one sid, possibly already present in several accounts — import to one that lacks it
    r = hits[0]
    have = {h["acct"] for h in hits}
    others = [a for a in CFG["accounts"] if a["label"] not in have]
    if to_label:
        others = [a for a in others if a["label"] == to_label]
    if not others:
        print("session already present in every account" if not to_label
              else f"session already present in {to_label}", file=sys.stderr)
        return 1
    if len(others) > 1:
        print("target account unclear — pass --to <label> (one of: %s)"
              % ", ".join(a["label"] for a in CFG["accounts"]), file=sys.stderr)
        return 1
    dest_acct = others[0]
    if r["sid"] in live_status() and not force:
        print("session looks live right now — resuming a copy forks it; "
              "re-run with --force to import anyway", file=sys.stderr)
        return 1
    dest_dir = os.path.join(dest_acct["projects"], os.path.basename(os.path.dirname(r["path"])))
    os.makedirs(dest_dir, exist_ok=True)
    dest = os.path.join(dest_dir, os.path.basename(r["path"]))
    if os.path.exists(dest) and not force:
        print(f"already imported: {dest}", file=sys.stderr)
    else:
        import shutil
        shutil.copy2(r["path"], dest)
    print(f"imported {r['sid'][:8]} ({r['acct']} → {dest_acct['label']})")
    print(f"        cd {r['cwd']} && {dest_acct['launcher']} --resume {r['sid']}")
    return 0


def refresh_http():
    """Socket-activated (Accept=yes) one-shot HTTP handler: stdin/stdout ARE
    the connection. GET / regenerates + republishes (lock guards double-
    clicks); GET /launch?sid=<uuid> opens that session in a desktop terminal
    with the right launcher for its account. Only a sid is accepted from the
    request — cwd and launcher are resolved server-side from the transcript."""
    import fcntl
    from urllib.parse import urlparse, parse_qs
    try:
        req = sys.stdin.buffer.readline().decode("latin1", "replace")
    except Exception:
        req = ""
    parts = req.split()
    u = urlparse(parts[1] if len(parts) > 1 else "/")

    def respond(status, body):
        sys.stdout.buffer.write(
            b"HTTP/1.1 %s\r\nAccess-Control-Allow-Origin: *\r\n"
            b"Content-Type: text/plain\r\nContent-Length: %d\r\n"
            b"Connection: close\r\n\r\n%s" % (status, len(body), body))
        sys.stdout.buffer.flush()

    if u.path == "/launch":
        sid = (parse_qs(u.query).get("sid") or [""])[0]
        if not re.fullmatch(r"[0-9a-fA-F-]{36}", sid):
            respond(b"400 Bad Request", b"bad sid")
            return 0
        hit = None
        for _label, launcher, root in HOMES:
            g = glob.glob(os.path.join(root, "*", sid + ".jsonl"))
            if g:
                hit = (launcher, g[0])
                break
        if not hit:
            respond(b"404 Not Found", b"unknown session")
            return 0
        launcher, tpath = hit
        cwd = scan(tpath)[0]
        if not cwd or not os.path.isdir(cwd):
            cwd = os.path.expanduser("~")
        env = dict(os.environ)
        env.setdefault("DISPLAY", ":0")
        env.setdefault("DBUS_SESSION_BUS_ADDRESS",
                       "unix:path=/run/user/%d/bus" % os.getuid())
        respond(b"200 OK", b"launched on the desktop")
        try:  # let the browser go before the terminal handshake
            os.close(0)
            os.close(1)
        except Exception:
            pass
        term = CFG.get("terminal_cmd") or [
            "gnome-terminal", "--working-directory", "{cwd}", "--",
            "bash", "-ic", "{cmd}; exec bash -i"]
        cmd = "%s --resume %s" % (launcher, sid)
        argv = [a.replace("{cwd}", cwd).replace("{cmd}", cmd) for a in term]
        log = open(os.path.join(CACHE_DIR, "refresh.log"), "ab")
        p = subprocess.Popen(argv, env=env, start_new_session=True,
                             stdout=log, stderr=log)
        # exiting immediately would let systemd kill the unit cgroup while the
        # terminal client is still mid-D-Bus-handshake — wait for the handoff
        # (the window's shell lives in the terminal server's unit, not ours)
        p.wait()
        return 0

    os.makedirs(CACHE_DIR, exist_ok=True)
    lock = open(os.path.join(CACHE_DIR, "refresh.lock"), "w")
    try:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        status, body = b"202 Accepted", b"refresh started; page rebuilds in ~1-2 min"
    except OSError:
        status, body = b"429 Too Many Requests", b"already refreshing"
    respond(status, body)
    if status[:3] != b"202":
        return 0
    try:  # release the browser before the slow part
        os.close(0)
        os.close(1)
    except Exception:
        pass
    log = open(os.path.join(CACHE_DIR, "refresh.log"), "ab")
    return subprocess.run(
        [sys.executable, os.path.abspath(__file__), "--publish"],
        stdin=subprocess.DEVNULL, stdout=log, stderr=log).returncode


def publish(paths_slugs):
    """Run the configured publish command once per page. The command is a
    shell string with {file} and {slug} placeholders."""
    cmd = CFG.get("publish_cmd")
    if not cmd:
        print("no publish_cmd configured — pages are local only:", file=sys.stderr)
        return 0
    rc = 0
    for path, slug in paths_slugs:
        r = subprocess.run(
            ["bash", "-lc", cmd.replace("{file}", path).replace("{slug}", slug)],
            capture_output=True, text=True)
        print(r.stdout.strip() or r.stderr.strip()[-300:])
        rc = rc or r.returncode
    return rc


def main():
    a = sys.argv[1:]
    if "--refresh-http" in a:
        return refresh_http()
    days = int(a[a.index("--days") + 1]) if "--days" in a else 45
    cap = int(a[a.index("--max") + 1]) if "--max" in a else 140
    if "--find" in a:
        rows = collect(max(days, 90), 400)
        return find(rows, a[a.index("--find") + 1]) or 0
    if "--resolve" in a:
        rows = collect(max(days, 90), 400)
        return resolve(rows, a[a.index("--resolve") + 1])
    if "--gist-queue" in a:
        limit = int(a[a.index("--limit") + 1]) if "--limit" in a else GIST_BATCH
        return gist_queue(collect(max(days, GIST_DAYS), TL_MAX), limit)
    if "--gist-write" in a:
        return gist_write(a[a.index("--gist-write") + 1])
    if "--import" in a:
        to = a[a.index("--to") + 1] if "--to" in a else None
        rows = collect(max(days, 90), 1000)
        return import_session(rows, a[a.index("--import") + 1], to, "--force" in a)
    # one scan feeds every page: the ladder carries EVERY session in the
    # window, the atlas stays the curated newest-N list with fresh gists
    tl_rows = collect(days, TL_MAX)
    rows = tl_rows[:cap]
    add_gists(tl_rows)
    build_deep_index(tl_rows)
    os.makedirs(HTML_DIR, exist_ok=True)
    open(OUT, "w").write(render(rows, days))
    open(OUT3, "w").write(render_ladder(tl_rows, days))
    pages = [(OUT, CFG["atlas_slug"]), (OUT3, CFG["ladder_slug"])]
    if CFG.get("timeline_redirect_slug"):
        redirect = ('<!doctype html><html lang="en"><head><meta charset="utf-8">'
                    '<meta http-equiv="refresh" content="0;url=%s"><title>moved</title>'
                    '</head><body><p>This design was retired — continue to the '
                    '<a href="%s">Claude session ladder</a>.</p></body></html>'
                    % (CFG["ladder_url"], CFG["ladder_url"]))
        open(OUT2, "w").write(redirect)
        pages.append((OUT2, CFG["timeline_redirect_slug"]))
    print(f"atlas: {len(rows)} sessions → {OUT} + ladder: {len(tl_rows)} → {OUT3}")
    if "--publish" in a:
        return publish(pages)
    return 0


if __name__ == "__main__":
    sys.exit(main())
