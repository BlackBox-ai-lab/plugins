#!/usr/bin/env python3
"""session-atlas — the standing map of every Claude Code session on this
machine: per-project groups, session names, topic snippets, "where we left
off" gists, and ready-to-paste resume commands, rendered as living HTML
pages the operator can open whenever they're lost.

Everything machine-specific lives in an optional config file
(~/.config/session-atlas/config.json, or $SESSION_ATLAS_CONFIG); with no
config the tool still works on a stock single-account install: it scans
~/.claude/projects, writes the pages under ~/.cache/session-atlas/html/,
and skips every optional layer (publishing, the refresh endpoint).
See references/config.md in the plugin for the schema and the degradation
table.

  session-atlas                      # render pages locally, print their paths
  session-atlas --publish            # also run the configured publish command
  session-atlas --find "<words>"     # compact matches + resume commands (agent-safe)
  session-atlas --resolve <q|sid>    # machine-readable resolution (TSV)
  session-atlas --import <sid>       # copy a session into another account
  session-atlas --gist-queue         # work-list for a session-driven gist pass
  session-atlas --gist-write F.json  # store {sid: gist} produced by that pass
  session-atlas --days 30 --max 150

Pages: the vertical recency ladder (primary — every session in the window,
newest first, density falling with age) and the per-project atlas (curated
newest-N). Sessions younger than GIST_DAYS carry a "where we left off" gist
written from the transcript tail, cached per (sid, mtime) so only sessions
that actually changed are ever re-summarized.

NO CREDENTIALS ANYWHERE. This script never calls a model. Gists are produced
by a Claude session's own model via --gist-queue / --gist-write (see the
refresh skill), so there is no API key, endpoint, or model id to configure.
Rendering and publishing run on cached gists and need nothing at all.

THE INDEX. Every command reads one SQLite file (stdlib sqlite3 + FTS5),
~/.cache/session-atlas/index.db. Each call stats every transcript (cheap) and
re-reads only those whose (size, mtime) changed since the last call, and each
of those reads is bounded: the first HEAD_BYTES and the last TAIL_BYTES of the
file, never the middle. So the first run pays once for every transcript on the
machine and every later call pays only for the sessions that moved.
"""
import calendar, glob, html, json, os, re, sqlite3, subprocess, sys, time
from collections import Counter

CONFIG_PATH = os.environ.get("SESSION_ATLAS_CONFIG",
                             os.path.expanduser("~/.config/session-atlas/config.json"))
CACHE_DIR = os.path.expanduser("~/.cache/session-atlas")
CACHE = os.path.join(CACHE_DIR, "summaries.json")
INDEX = os.path.join(CACHE_DIR, "index.db")
INDEX_VERSION = 1   # bump when the schema or what a row holds changes -> rebuild
HEAD_BYTES = 131072    # read from the start of a changed transcript
TAIL_BYTES = 262144    # read from the end of a changed transcript
MIN_BYTES = 2000       # smaller transcripts are aborted starts, never indexed
BODY_CHARS = 8000      # operator prompts kept per session for search
DEEP_WORDS = 400       # frequency-ranked words kept per session for search
QUEUE = os.path.join(CACHE_DIR, "gist-queue.json")
HTML_DIR = os.path.join(CACHE_DIR, "html")
OUT = os.path.join(HTML_DIR, "session-atlas.html")
OUT2 = os.path.join(HTML_DIR, "session-timeline.html")
OUT3 = os.path.join(HTML_DIR, "session-ladder.html")

TL_COLORS = ["#2a78d6", "#1baf7a", "#eda100", "#008300",
             "#4a3aa7", "#e34948", "#e87ba4", "#eb6834"]
TL_OTHER = "#898781"
TL_MAX = 2000       # ladder carries every session in the window (atlas stays curated)
TL_DEEP = 400       # newest N ladder cards carry transcript words for the page's own search
BOILER = "This session is being continued from a previous conversation"
GIST_DAYS = 30     # gist eligibility: younger than this AND within GIST_MAX newest
GIST_MAX = 450
GIST_BATCH = 12    # sessions queued per --gist-queue pass; converges over runs
GIST_TAIL_CHARS = 2500   # transcript tail handed over per session
PRUNE_DAYS = 120   # cache entries idle this long are dropped
GIST_PROMPT = (
    "Each item below is the tail end of a Claude Code working session transcript. "
    "For each one, in 1-2 sentences (max 45 words), state where the work currently "
    "stands and what is immediately pending — the gist the operator needs to "
    "remember where they left off. Present tense, specific names/artifacts/"
    "decisions, no preamble, no markdown.")


def load_config():
    """Config with safe defaults: a stock install needs no config at all."""
    cfg = {}
    try:
        cfg = json.load(open(CONFIG_PATH))
    except Exception:
        pass
    accounts = cfg.get("accounts") or [
        {"label": "a1", "launcher": "claude",
         "projects": "~/.claude/projects", "sessions": "~/.claude/sessions"}]
    for a in accounts:
        a["projects"] = os.path.expanduser(a["projects"])
        a["sessions"] = os.path.expanduser(
            a.get("sessions") or os.path.join(os.path.dirname(a["projects"]), "sessions"))
        a.setdefault("label", "a1")
        a.setdefault("launcher", "claude")
    cfg["accounts"] = accounts
    cfg.setdefault("atlas_url", "file://" + OUT)
    cfg.setdefault("ladder_url", "file://" + OUT3)
    cfg.setdefault("atlas_slug", "session-atlas")
    cfg.setdefault("ladder_slug", "session-ladder")
    # publish_cmd: shell string with {file} and {slug} placeholders (optional)
    # refresh_url: the ladder's ↻/▶ endpoint (optional; buttons hidden without it)
    # timeline_redirect_slug: publish a redirect stub for a retired slug (optional)
    # terminal_cmd: argv list with {cwd} and {cmd} placeholders (optional)
    return cfg


CFG = load_config()
HOMES = [(a["label"], a["launcher"], a["projects"]) for a in CFG["accounts"]]
LIVE_DIRS = [a["sessions"] for a in CFG["accounts"]]


def _text(content):
    if isinstance(content, str):
        return content
    if isinstance(content, list):
        return " ".join(b["text"] for b in content
                        if isinstance(b, dict) and isinstance(b.get("text"), str))
    return ""


def _is_prompt(t):
    """A real operator prompt, not harness boilerplate or a tool result."""
    return bool(t) and not t.startswith("<") and "Caveat:" not in t[:40] \
        and not t.startswith(BOILER)


def _parse_lines(data):
    """Facts from one window of transcript lines (oldest -> newest). Titles are
    last-write-wins within the window; `first` is the window's first prompt."""
    f = dict(cwd=None, started=None, name=None, ai_title=None, summary=None,
             first=None, prompts=[], texts=[])
    for ln in data.splitlines():
        try:
            rec = json.loads(ln)
        except Exception:
            continue
        if not isinstance(rec, dict):
            continue
        typ = rec.get("type")
        # a field of the wrong type (a malformed record) counts as absent
        def sv(k):
            v = rec.get(k)
            return v if isinstance(v, str) and v else None
        if f["started"] is None and sv("timestamp"):
            f["started"] = rec["timestamp"]
        if f["cwd"] is None and sv("cwd"):
            f["cwd"] = rec["cwd"]
        if typ == "summary" and sv("summary"):
            f["summary"] = rec["summary"]
        # the harness writes structured rename records — canonical, last wins
        if typ == "custom-title" and sv("customTitle"):
            f["name"] = rec["customTitle"]
        elif typ == "agent-name" and sv("agentName"):
            f["name"] = rec["agentName"]
        # the title Claude generates and DISPLAYS. Deliberately NOT folded
        # into `name`, which means "the operator named this" — other logic
        # keys on that distinction. Rewritten as a session evolves.
        elif typ == "ai-title" and sv("aiTitle"):
            f["ai_title"] = rec["aiTitle"]
        m = rec.get("message") or {}
        if not isinstance(m, dict):
            m = {}
        if typ == "user":
            t = _text(m.get("content")).strip()
            if _is_prompt(t):
                if f["first"] is None:
                    f["first"] = t
                if not rec.get("isMeta"):
                    f["prompts"].append(t[:1500])
                    f["texts"].append(t[:1500])
        elif typ == "assistant":
            a = _text(m.get("content")).strip()
            if a:
                f["texts"].append(a[:1500])
        if "named this session" in ln:
            s = _text(m.get("content"))
            j = s.find("named this session")
            if j >= 0:
                f["name"] = f["name"] or s[j + 18:].split(".")[0].strip().strip(' "“”')
    return f


_CWD_RE = re.compile(r'"cwd":"((?:[^"\\]|\\.)*)"')
_TS_RE = re.compile(r'"timestamp":"([0-9T:.\-]+Z?)"')


def read_bounded(path, size):
    """The head and tail windows of one transcript — never the middle. A file
    that fits in both windows is read once and serves as both."""
    with open(path, "rb") as fh:
        if size <= HEAD_BYTES + TAIL_BYTES:
            data = fh.read().decode("utf-8", "replace")
            return data, data
        head = fh.read(HEAD_BYTES).decode("utf-8", "replace")
        fh.seek(size - TAIL_BYTES)
        fh.readline()  # drop the partial line at the seek point
        tail = fh.read().decode("utf-8", "replace")
    # a head cut mid-line leaves a partial record; _parse_lines skips it
    return head, tail


def scan(path, prev=None):
    """Bounded read of one transcript -> the facts a row needs. `prev` is the
    row stored for this path before it changed: a rename or retitle that has
    since scrolled out of both windows is kept rather than forgotten."""
    prev = prev or {}
    try:
        size = os.path.getsize(path)
        head_s, tail_s = read_bounded(path, size)
    except OSError:
        return None
    whole = head_s is tail_s
    h = _parse_lines(head_s)
    t = h if whole else _parse_lines(tail_s)
    cwd = h["cwd"] or t["cwd"]
    if not cwd:  # first record longer than the head window
        m = _CWD_RE.search(head_s)
        cwd = json.loads('"%s"' % m.group(1)) if m else None
    started = h["started"]
    if not started:
        m = _TS_RE.search(head_s)
        started = m.group(1) if m else None
    start = None
    if started:
        try:
            start = calendar.timegm(time.strptime(started[:19], "%Y-%m-%dT%H:%M:%S"))
        except Exception:
            start = None
    # tail beats what we knew beats head: the head holds only the first guess
    name = t["name"] or prev.get("name") or h["name"]
    ai_title = t["ai_title"] or prev.get("ai_title") or h["ai_title"]
    summary = t["summary"] or prev.get("summary") or h["summary"]
    prompts = h["prompts"] if whole else h["prompts"] + t["prompts"]
    texts = h["texts"] if whole else h["texts"] + t["texts"]
    words = re.findall(r"[a-z0-9][a-z0-9_.-]{2,24}", " ".join(texts).lower())
    # frequency-ranked so truncation drops rare noise, not alphabet ranges
    deep = " ".join(w for w, _ in Counter(words).most_common(DEEP_WORDS))
    return dict(cwd=cwd, start=start, name=name or "", ai_title=(ai_title or "")[:200],
                first=(h["first"] or t["first"] or "")[:200], summary=(summary or "")[:280],
                body=" \n".join(prompts)[:BODY_CHARS], deep=deep)


def _repo_of(cwd):
    # worktree cwds (<repo>/.claude/worktrees/<x>) consolidate silently into
    # their parent repo — worktrees are plumbing the operator never sees
    if "/.claude/worktrees/" in cwd:
        return os.path.basename(cwd.partition("/.claude/worktrees/")[0])
    return os.path.basename(cwd)


SCHEMA = """
CREATE TABLE sessions(
  id INTEGER PRIMARY KEY, path TEXT UNIQUE NOT NULL, sid TEXT NOT NULL,
  acct TEXT NOT NULL, launcher TEXT NOT NULL, size INTEGER NOT NULL,
  mtime REAL NOT NULL, start INTEGER, cwd TEXT, repo TEXT, name TEXT,
  ai_title TEXT, first TEXT, summary TEXT, gist TEXT NOT NULL DEFAULT '');
CREATE INDEX sessions_sid ON sessions(sid);
CREATE INDEX sessions_mtime ON sessions(mtime);
CREATE VIRTUAL TABLE fts USING fts5(
  title, repo, first, summary, gist, body, deep,
  tokenize='porter unicode61 remove_diacritics 2');
CREATE TABLE meta(k TEXT PRIMARY KEY, v TEXT);
"""
# bm25 column weights, in fts column order: a title hit outweighs a word
# somewhere in the transcript
WEIGHTS = (10.0, 6.0, 3.0, 3.0, 4.0, 1.5, 1.0)


class IndexBusy(Exception):
    pass


def _prefetch(path):
    """Read a file front to back once. A cold query touches pages scattered
    across the index, and on a spinning disk those random reads cost far more
    than one sequential pass; on a warm cache this costs milliseconds."""
    try:
        with open(path, "rb", buffering=0) as fh:
            while fh.read(1 << 20):
                pass
    except OSError:
        pass


def _connect():
    os.makedirs(CACHE_DIR, exist_ok=True)
    for f in (INDEX, INDEX + "-wal"):
        _prefetch(f)
    if not os.path.exists(INDEX):  # it holds prompt text: owner-only
        os.close(os.open(INDEX, os.O_CREAT | os.O_WRONLY, 0o600))
    db = sqlite3.connect(INDEX, timeout=2)
    db.row_factory = sqlite3.Row
    try:
        db.execute("PRAGMA journal_mode=WAL")
    except sqlite3.OperationalError:
        pass  # another process holds the write lock; reads still work
    # the index is a rebuildable cache: skip the per-commit fsync
    db.execute("PRAGMA synchronous=NORMAL")
    if db.execute("PRAGMA user_version").fetchone()[0] != INDEX_VERSION:
        try:
            db.execute("BEGIN IMMEDIATE")
        except sqlite3.OperationalError as e:
            raise IndexBusy("the index is being rebuilt by another process; "
                            "retry shortly (%s)" % e)
        # re-check under the lock: a concurrent first run may have just built it
        if db.execute("PRAGMA user_version").fetchone()[0] == INDEX_VERSION:
            db.rollback()
            return db
        for tbl in ("sessions", "fts", "meta"):
            db.execute("DROP TABLE IF EXISTS %s" % tbl)
        db.executescript(SCHEMA)  # executescript COMMITs first; fine here
        db.execute("PRAGMA user_version=%d" % INDEX_VERSION)
        db.commit()
    return db


def _eligible():
    """(path, acct, launcher, size, mtime) for every indexable transcript —
    one stat per file, no reads."""
    out = []
    for label, launcher, root in HOMES:
        for f in glob.glob(os.path.join(root, "*", "*.jsonl")):
            if "/-tmp" in f or ".orphaned-" in f or "-claude-jobs-" in f:
                continue
            try:
                st = os.stat(f)
            except OSError:
                continue
            if st.st_size > MIN_BYTES:
                out.append((f, label, launcher, st.st_size, st.st_mtime))
    return out


def _gists_changed(db):
    """summaries.json's mtime if it changed since the index last copied its
    gists, else None."""
    try:
        cmt = str(os.path.getmtime(CACHE))
    except OSError:
        return None
    row = db.execute("SELECT v FROM meta WHERE k='gists_mtime'").fetchone()
    return None if row and row[0] == cmt else cmt


def _sync_gists(db):
    """Copy gists from summaries.json (their store of record) into the index
    whenever that file changed since the last copy."""
    cmt = _gists_changed(db)
    if cmt is None:
        return
    cache = _load_cache()
    for r in db.execute("SELECT id, sid, gist FROM sessions").fetchall():
        g = (cache.get(r["sid"]) or {}).get("gist") or ""
        if g != r["gist"]:
            db.execute("UPDATE sessions SET gist=? WHERE id=?", (g, r["id"]))
            db.execute("UPDATE fts SET gist=? WHERE rowid=?", (g, r["id"]))
    db.execute("INSERT OR REPLACE INTO meta VALUES('gists_mtime', ?)", (cmt,))


def _plan(db, files):
    """(todo, gone) against the index as it stands now. A row whose account
    root is missing right now (an unmounted disk, another HOME) is kept, not
    dropped: an absent directory is not evidence its transcripts are gone."""
    known = {r["path"]: ((r["size"], r["mtime"]), r["acct"]) for r in
             db.execute("SELECT path, size, mtime, acct FROM sessions")}
    todo = [x for x in files if (known.get(x[0]) or (None,))[0] != (x[3], x[4])]
    absent = {label for label, _l, root in HOMES if not os.path.isdir(root)}
    on_disk = {x[0] for x in files}
    gone = [p for p, (_st, acct) in known.items()
            if p not in on_disk and acct not in absent]
    return todo, gone


def _stub(path):
    """Facts for a transcript that could not be parsed: indexed with no cwd,
    so no query returns it and it is not re-read until it changes."""
    return dict(cwd=None, start=None, name="", ai_title="", first="", summary="",
                body="", deep="")


def update_index(db):
    """Bring the index in line with the transcripts on disk: stat everything,
    re-read (bounded) only what changed, drop what vanished. If another
    process is already writing, answer from the index as it stands."""
    files = _eligible()
    todo, gone = _plan(db, files)
    if not todo and not gone and not _gists_changed(db):
        return  # nothing moved: no write transaction at all
    try:
        db.execute("BEGIN IMMEDIATE")
    except sqlite3.OperationalError:
        return
    # re-plan under the lock: a concurrent call may have done the work already
    todo, gone = _plan(db, files)
    if len(todo) > 200:
        print("session-atlas: indexing %d transcripts (once; later calls read "
              "only what changed)..." % len(todo), file=sys.stderr, flush=True)
    cache = _load_cache() if todo else {}
    for p in gone:
        r = db.execute("SELECT id FROM sessions WHERE path=?", (p,)).fetchone()
        if r is None:
            continue
        db.execute("DELETE FROM fts WHERE rowid=?", (r["id"],))
        db.execute("DELETE FROM sessions WHERE id=?", (r["id"],))
    for n, (path, label, launcher, size, mtime) in enumerate(todo, 1):
        old = db.execute("SELECT * FROM sessions WHERE path=?", (path,)).fetchone()
        if old and (old["size"], old["mtime"]) == (size, mtime):
            continue  # another call indexed it between our commits
        try:
            f = scan(path, dict(old) if old else None)
        except Exception as e:  # one malformed transcript must not stop the rest
            print("session-atlas: skipping unreadable transcript %s (%s: %s)"
                  % (path, type(e).__name__, e), file=sys.stderr)
            f = None
        if f is None:
            f = _stub(path)
        sid = os.path.basename(path)[:-6]
        gist = (cache.get(sid) or {}).get("gist") or ""
        repo = _repo_of(f["cwd"]) if f["cwd"] else None
        vals = (path, sid, label, launcher, size, mtime, f["start"], f["cwd"], repo,
                f["name"], f["ai_title"], f["first"], f["summary"], gist)
        if old:
            rid = old["id"]
            db.execute("UPDATE sessions SET path=?, sid=?, acct=?, launcher=?, size=?, "
                       "mtime=?, start=?, cwd=?, repo=?, name=?, ai_title=?, first=?, "
                       "summary=?, gist=? WHERE id=?", vals + (rid,))
            db.execute("DELETE FROM fts WHERE rowid=?", (rid,))
        else:
            rid = db.execute("INSERT INTO sessions(path, sid, acct, launcher, size, mtime, "
                             "start, cwd, repo, name, ai_title, first, summary, gist) "
                             "VALUES(?,?,?,?,?,?,?,?,?,?,?,?,?,?)", vals).lastrowid
        db.execute("INSERT INTO fts(rowid, title, repo, first, summary, gist, body, deep) "
                   "VALUES(?,?,?,?,?,?,?,?)",
                   (rid, " ".join(x for x in (f["name"], f["ai_title"]) if x),
                    (repo or "") + " " + (f["cwd"] or ""), f["first"], f["summary"],
                    gist, f["body"], f["deep"]))
        if n % 250 == 0:  # an interrupted first build keeps its progress
            db.commit()
            try:
                db.execute("BEGIN IMMEDIATE")
            except sqlite3.OperationalError:
                return  # another call took over; it finishes the rest
    _sync_gists(db)
    db.commit()


def open_index():
    db = _connect()
    update_index(db)
    return db


def _row(r, deep=""):
    return dict(mtime=r["mtime"], start=r["start"], acct=r["acct"],
                launcher=r["launcher"], sid=r["sid"], path=r["path"], repo=r["repo"],
                cwd=r["cwd"], name=r["name"] or None, gist=r["gist"] or "",
                ai_title=r["ai_title"] or "", first=r["first"] or "",
                summary=r["summary"] or "", deep=deep)


def tail_records(path, tail_bytes=262144, keep=24):
    """Bounded read of a transcript's TAIL: the last meaningful user/assistant
    texts (oldest→newest) + any late rename or retitle. Never reads the whole
    file."""
    texts, late_name, late_title = [], None, None
    try:
        size = os.path.getsize(path)
        with open(path, "rb") as fh:
            if size > tail_bytes:
                fh.seek(size - tail_bytes)
                fh.readline()  # drop the partial line at the seek point
            data = fh.read().decode(errors="replace")
        for ln in data.splitlines():
            try:
                rec = json.loads(ln)
            except Exception:
                continue
            if not isinstance(rec, dict):
                continue
            if rec.get("type") == "custom-title" and rec.get("customTitle"):
                late_name = rec["customTitle"]
            elif rec.get("type") == "ai-title" and rec.get("aiTitle"):
                # a long session's title is rewritten as it goes, so the tail
                # holds the current one — the head only holds the first guess
                late_title = rec["aiTitle"]
            m = rec.get("message") or {}
            t = None
            if rec.get("type") == "user" and not rec.get("isMeta"):
                u = _text(m.get("content")).strip()
                if u and not u.startswith("<") and "Caveat:" not in u[:40] and not u.startswith(BOILER):
                    t = "OPERATOR: " + u
            elif rec.get("type") == "assistant":
                a = _text(m.get("content")).strip()
                if a:
                    t = "AGENT: " + a
            if t:
                texts.append(t[:1500])
    except Exception:
        pass
    return texts[-keep:], late_name, late_title


def _needs_gist(rows, cache):
    """Sessions eligible for a gist that don't have a current one."""
    cutoff = time.time() - GIST_DAYS * 86400
    out = []
    for i, r in enumerate(rows):          # rows arrive newest-first
        if i >= GIST_MAX or r["mtime"] < cutoff:
            continue
        c = cache.get(r["sid"])
        if c and c.get("mtime") == int(r["mtime"]) and c.get("gist"):
            continue
        out.append(r)
    return out


def gist_queue(rows, limit):
    """Write the work-list for a session-driven gist pass; print a pointer.

    Transcript text goes to a FILE, never to stdout — the caller hands the
    path to a subagent, so raw transcript never enters the orchestrating
    session's context. Bounded per pass; the backlog converges over runs."""
    cache = _load_cache()
    items = []
    for r in _needs_gist(rows, cache):
        if len(items) >= limit:
            break
        texts, _late, _title = tail_records(r["path"])
        tail = "\n\n".join(texts)[-GIST_TAIL_CHARS:].strip()
        if not tail:
            # nothing summarizable (aborted/meta-only session). Skipping keeps it
            # out of every future queue too — otherwise it would occupy a slot
            # forever, since a session with no gist always "needs" one.
            continue
        items.append({"sid": r["sid"], "repo": r["repo"],
                      "title": (r["name"] or r["ai_title"] or r["first"] or "")[:80],
                      "mtime": int(r["mtime"]),
                      "tail": tail})
    os.makedirs(CACHE_DIR, exist_ok=True)
    with open(QUEUE, "w") as fh:
        json.dump({"instruction": GIST_PROMPT, "items": items}, fh)
    print("queued %d session(s) -> %s" % (len(items), QUEUE))
    return 0


def gist_write(path):
    """Store {sid: gist} against the mtime recorded when each was queued, so a
    session that changed mid-pass is simply re-queued on the next run."""
    try:
        data = json.load(open(path))
    except Exception as e:
        print("cannot read gists: %s" % e, file=sys.stderr)
        return 1
    gists = data.get("gists", data) if isinstance(data, dict) else {}
    try:
        queued = {i["sid"]: i for i in json.load(open(QUEUE)).get("items", [])}
    except Exception:
        queued = {}
    cache = _load_cache()
    n = 0
    for sid, text in (gists or {}).items():
        text = (text or "").strip()
        if not text or sid not in queued:
            continue
        c = cache.setdefault(sid, {})
        c.update(mtime=queued[sid]["mtime"], gist=text)
        n += 1
    if n:
        _save_cache(cache)
    print("wrote %d gist(s)" % n)
    return 0


def _load_cache():
    try:
        return json.load(open(CACHE))
    except Exception:
        return {}


def _save_cache(cache):
    cutoff = time.time() - PRUNE_DAYS * 86400
    cache = {k: v for k, v in cache.items()
             if max(v.get("mtime", 0), v.get("seen_mtime", 0), v.get("deep_mtime", 0)) >= cutoff}
    os.makedirs(CACHE_DIR, exist_ok=True)
    json.dump(cache, open(CACHE, "w"))


def add_gists(rows):
    """Fill in cached gists and late renames. Never generates anything — gists
    are written by --gist-queue / --gist-write, driven by a Claude session's own
    model, so this path needs no API key, endpoint, or model id."""
    cache = _load_cache()
    for r in rows:
        c = cache.get(r["sid"])
        if c:
            r["gist"] = c.get("gist") or ""
            if not r["name"] and c.get("name"):
                r["name"] = c["name"]


def mirror_to_cache(rows):
    """Keep summaries.json carrying each rendered session's name and deep
    words. The index is the search store now; this file stays the gist store
    of record and a stable read surface for sibling tools."""
    cache = _load_cache()
    dirty = False
    for r in rows:
        c = cache.setdefault(r["sid"], {})
        # `mtime` is the version a gist was written for (_needs_gist compares
        # it): stamping the session's current mtime over an old gist would
        # mark that gist current. `seen_mtime` keeps the entry from pruning.
        want = dict(seen_mtime=int(r["mtime"]), name=r["name"] or c.get("name") or "")
        if not c.get("gist"):
            want["mtime"] = int(r["mtime"])
        if r.get("deep"):
            want.update(deep=r["deep"], deep_mtime=int(r["mtime"]))
        if any(c.get(k) != v for k, v in want.items()):
            c.update(want)
            dirty = True
    if dirty:
        _save_cache(cache)


def live_status():
    """sessionId -> status for currently-running sessions (best-effort)."""
    out = {}
    for live_dir in LIVE_DIRS:
        try:
            for f in glob.glob(os.path.join(live_dir, "*.json")):
                try:
                    d = json.load(open(f))
                    if d.get("sessionId") and d.get("status") == "running":
                        out[d["sessionId"]] = "running"
                except Exception:
                    continue
        except Exception:
            pass
    return out


def collect(days, cap, db=None):
    """The newest `cap` sessions active in the last `days`, from the index."""
    db = db or open_index()
    cutoff = time.time() - days * 86400
    return [_row(r, r["deep"]) for r in db.execute(
        "SELECT s.*, f.deep AS deep FROM sessions s JOIN fts f ON f.rowid = s.id "
        "WHERE s.cwd IS NOT NULL AND s.mtime >= ? ORDER BY s.mtime DESC LIMIT ?",
        (cutoff, cap))]


def _ago(secs):
    if secs < 3600: return f"{max(1, int(secs // 60))}m ago"
    if secs < 172800: return f"{int(secs // 3600)}h ago"
    return f"{int(secs // 86400)}d ago"


def _heat(rs, days=14):
    """Pure-CSS per-repo activity strip: one cell per day (oldest→newest),
    intensity = sessions last-touched that day."""
    now = time.time()
    counts = [0] * days
    for r in rs:
        d = int((now - r["mtime"]) // 86400)
        if 0 <= d < days:
            counts[d] += 1
    cells = []
    for d in reversed(range(days)):
        c = counts[d]
        if c:
            cells.append(f'<i style="opacity:{min(1.0, 0.3 + 0.28 * c):.2f}"></i>')
        else:
            cells.append('<i class="z"></i>')
    return f'<span class="heat" title="last {days} days">{"".join(cells)}</span>'


def render(rows, days):
    groups = {}
    for r in rows:
        groups.setdefault(r["repo"], []).append(r)
    ordered = sorted(groups.items(), key=lambda kv: -kv[1][0]["mtime"])
    e = html.escape
    parts = [f"""<!doctype html><html lang="en"><head><meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Claude session atlas</title><style>
body{{margin:0;background:#faf9f7;color:#1a1a1f;font:15px/1.55 Inter,-apple-system,sans-serif;padding:0 0 60px}}
.wrap{{max-width:960px;margin:0 auto;padding:0 20px}}
header{{border-bottom:3px solid #e04e00;background:#fff;padding:26px 0 18px;margin-bottom:26px}}
h1{{font-size:24px;margin:0 0 4px}} .sub{{color:#5c5a55;font-size:13px}}
h2{{font-size:17px;margin:26px 0 8px}} h2 .n{{color:#e04e00;font-family:monospace;font-size:13px}}
h2 .ago{{color:#a09d96;font-size:12px;font-weight:400;margin-left:8px}}
.heat{{margin-left:10px;vertical-align:middle}}
.heat i{{display:inline-block;width:7px;height:11px;margin-right:2px;background:#e04e00;border-radius:2px}}
.heat i.z{{background:#e6e3dd}}
.live{{display:inline-block;font-size:10.5px;font-weight:600;padding:0 6px;border-radius:9px;margin-left:6px;background:#e8f7ec;color:#0a7d33}}
.s{{background:#fff;border:1px solid #e6e3dd;border-radius:9px;padding:12px 15px;margin:8px 0}}
.when{{font-family:monospace;font-size:11.5px;color:#a05a00}}
.nm{{font-weight:650}} .unnamed{{color:#5c5a55;font-weight:400;font-style:italic}}
.topic{{font-size:13px;color:#5c5a55;margin:3px 0}}
code{{font-family:monospace;font-size:12px;background:#f2f0ec;border-radius:4px;padding:1px 6px}}
.acct{{display:inline-block;font-family:monospace;font-size:10.5px;padding:0 6px;border-radius:9px;margin-left:6px;background:#eaf2f9;color:#20507a}}
</style></head><body><header><div class="wrap">
<h1>Claude session atlas</h1><div class="sub">What every conversation has been building — last {days} days,
grouped by project, <b>most recently active repo first</b>. The newest sessions in each repo carry a
"where we left off" gist from the transcript tail. Resume any session by pasting its command in a
terminal. Ladder view: <a href="{CFG['ladder_url']}">session ladder</a>.
Updated {time.strftime('%Y-%m-%d %H:%M %Z')}.</div></div></header><div class="wrap">"""]
    live = live_status()
    for repo, rs in ordered:
        ago = _ago(time.time() - rs[0]["mtime"])
        parts.append(f'<h2><span class="n">{len(rs)}·</span> {e(repo)}'
                     f'<span class="ago">last active {ago}</span>{_heat(rs)}</h2>')
        for r in rs:
            when = time.strftime("%a %m-%d %H:%M", time.localtime(r["mtime"]))
            # a session the operator never renamed still HAS a title on screen:
            # the one Claude generated. It wears that, falling back to its first
            # prompt — an empty "(unnamed)" marker tells the operator nothing
            if r["name"]:
                nm = f'<span class="nm">{e(r["name"])}</span>'
                topic = r.get("gist") or r["ai_title"] or r["summary"] or r["first"]
            else:
                head = r["ai_title"] or r["first"] or r["summary"] or "(empty session)"
                nm = ('<span class="nm" style="font-weight:500">'
                      f'{e(head[:110])}</span>')
                # when the title took the head, the opening prompt drops here
                topic = (r.get("gist") or r["summary"]
                         or (r["first"] if r["ai_title"] else ""))
            badge = '<span class="live">● running</span>' if r["sid"] in live else ""
            parts.append(
                f'<div class="s"><span class="when">{when}</span> {nm}'
                f'<span class="acct">{r["acct"]}</span>{badge}'
                f'<div class="topic">{e(topic)}</div>'
                f'<code>{e(r["launcher"])} --resume {r["sid"]}</code>'
                f' <code style="opacity:.6">cd {e(r["cwd"])}</code></div>')
    parts.append("</div></body></html>")
    return "".join(parts)


